# Copy to .env.production on the server. Never commit the resulting file.
# Passwords used inside PostgreSQL URLs must be URL-safe; lowercase hex is recommended.

IMAGE_TAG=2026-07-13
API_DOMAIN=api.example.cn
ADMIN_DOMAIN=admin.example.cn
ACME_EMAIL=ops@example.cn

POSTGRES_DB=scan_wifi
POSTGRES_OWNER_USER=scan_wifi_owner
POSTGRES_OWNER_PASSWORD=replace_with_48_lowercase_hex_characters
POSTGRES_APP_USER=scan_wifi_app
POSTGRES_APP_PASSWORD=replace_with_a_different_48_lowercase_hex_value
DATABASE_POOL_MAX=10
DATABASE_BACKUP_URL=postgresql://scan_wifi_owner:replace_owner_password@postgres:5432/scan_wifi

WIFI_ENCRYPTION_KEY_BASE64=replace_with_openssl_rand_base64_32
SESSION_SECRET=replace_with_openssl_rand_hex_64
SESSION_TTL_HOURS=12

INITIAL_ADMIN_USERNAME=wifi_admin
INITIAL_ADMIN_PASSWORD=replace_only_for_the_one_time_init_command

WECHAT_APP_ID=wx_replace_with_formal_app_id
WECHAT_APP_SECRET=replace_with_server_only_app_secret
WECHAT_QR_PAGE=pages/connect/index

MINIPROGRAM_ENABLE_LEGACY_WIFI_API=false
MINIPROGRAM_AD_UNIT_ID=
MINIPROGRAM_BRAND_NAME=轻连 WiFi
ENABLE_ADS=false
ENABLE_ANALYTICS=true
ENABLE_WIFI_DIAGNOSTICS=false

# Fixed and verified by docker-compose.prod.yml / prod:preflight:
# NODE_ENV=production
# COOKIE_SECURE=true
# WECHAT_ENV_VERSION=release
# QR_CODE_PROVIDER=wechat

BACKUP_HOST_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
