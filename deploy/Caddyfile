{
	email {$ACME_EMAIL}
	admin off
	log {
		output stdout
		format json
	}
}

{$API_DOMAIN} {
	encode zstd gzip
	log {
		output stdout
		format json
	}

	@documentation path /documentation /documentation/*
	respond @documentation 404

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	reverse_proxy api:3100
}

{$ADMIN_DOMAIN} {
	encode zstd gzip
	log {
		output stdout
		format json
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	reverse_proxy admin:8080
}
