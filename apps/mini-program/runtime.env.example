# Safe defaults. Copy the values you need into the environment before running
# `pnpm config:generate`; this file is documentation and is not loaded automatically.
MINIPROGRAM_BUILD_MODE=development
MINIPROGRAM_API_BASE_URL=
MINIPROGRAM_ALLOW_INSECURE_LOCALHOST=false
MINIPROGRAM_ALLOW_PLACEHOLDER_API=false
MINIPROGRAM_ENABLE_LEGACY_WIFI_API=false
MINIPROGRAM_LEGACY_WIFI_MANUAL_SYSTEM_CONNECTION=false
MINIPROGRAM_AD_UNIT_ID=
MINIPROGRAM_BRAND_NAME=轻连 WiFi
ENABLE_ADS=false
ENABLE_ANALYTICS=true
ENABLE_WIFI_DIAGNOSTICS=true
# release always forces ENABLE_WIFI_DIAGNOSTICS=false and removes that page.

# For explicit loopback development, run `pnpm build:local` or set:
# MINIPROGRAM_API_BASE_URL=http://127.0.0.1:3100
# MINIPROGRAM_ALLOW_INSECURE_LOCALHOST=true

# A trial build may use an example.cn/example.com API only when it is explicitly
# marked as internal-only:
# MINIPROGRAM_ALLOW_PLACEHOLDER_API=true

# Production generation uses `pnpm build:production` (or
# MINIPROGRAM_BUILD_MODE=production), requires a non-empty HTTPS API URL, and
# requires MINIPROGRAM_ALLOW_INSECURE_LOCALHOST=false, rejects example domains,
# and ignores MINIPROGRAM_ALLOW_PLACEHOLDER_API.
# Server-only credentials are intentionally unsupported and must remain on the API.
