<view class="page-shell phase-{{phase}} {{motionActive ? '' : 'motion-paused'}} {{phase === 'loading' || phase === 'initializing_wifi' || phase === 'connecting' ? 'is-connecting' : ''}}">
  <view class="connection-panel">
    <view class="signal-stage" aria-hidden="true">
      <view class="signal-orbit">
        <view class="orbit-track"><view class="orbit-dot" /></view>
      </view>
      <view wx:if="{{phase === 'success'}}" class="success-ring" />
      <view class="signal-tile">
        <view wx:if="{{phase === 'success'}}" class="success-check" />
        <view wx:else class="wifi-symbol">
          <view class="signal-arc signal-arc--outer" />
          <view class="signal-arc signal-arc--inner" />
          <view class="signal-dot" />
        </view>
      </view>
    </view>
    <view wx:if="{{hasConfig}}" class="network-wrap">
      <view class="card-depth" aria-hidden="true" />
      <view class="network-card">
        <view class="field field--name">
          <text class="label">WiFi 名称</text>
          <text id="wifi-ssid" class="value value--ssid" user-select>{{ssid}}</text>
        </view>
        <view class="field field--password">
          <text class="label">WiFi 密码</text>
          <text id="wifi-password" class="value value--password" user-select>{{password}}</text>
        </view>
      </view>
    </view>
    <view class="button-enter">
      <button class="primary-button" hover-class="primary-button--pressed" hover-stay-time="100" disabled="{{buttonDisabled}}" loading="{{phase === 'loading' || phase === 'initializing_wifi' || phase === 'connecting'}}" bindtap="onPrimaryTap">
        <text>{{buttonLabel}}</text>
        <view wx:if="{{!buttonDisabled}}" class="button-arrow" aria-hidden="true" />
      </button>
    </view>
    <view class="status-space">
      <view wx:if="{{phase !== 'waiting' || !hasConfig}}" class="status status--{{statusTone}}" aria-live="polite">
        <text class="status-title">{{statusTitle}}</text>
        <text class="status-message">{{statusMessage}}</text>
      </view>
    </view>
  </view>
</view>
