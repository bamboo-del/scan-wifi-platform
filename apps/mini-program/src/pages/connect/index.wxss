.page-shell {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 48rpx 40rpx 80rpx;
  background: linear-gradient(160deg, #f0f5ff 0%, #f8fafc 48%, #fff 100%);
}
.connection-panel {
  max-width: 640rpx;
  margin: 0 auto;
}
.signal-stage {
  position: relative;
  height: 280rpx;
  perspective: 600rpx;
  animation: enter 560ms ease-out both;
}
.signal-orbit {
  position: absolute;
  top: 12rpx;
  left: 50%;
  width: 256rpx;
  height: 256rpx;
  margin-left: -128rpx;
  transform: rotateX(58deg) rotateZ(-20deg);
}
.orbit-track {
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  border: 2rpx solid #d5e2fa;
  border-radius: 50%;
}
.orbit-dot {
  position: absolute;
  top: -5rpx;
  left: 50%;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #8badef;
}
.signal-tile {
  position: absolute;
  top: 68rpx;
  left: 50%;
  width: 144rpx;
  height: 144rpx;
  margin-left: -72rpx;
  border: 2rpx solid #fff;
  border-radius: 44rpx;
  background: linear-gradient(145deg, #fff, #edf3ff);
  box-shadow:
    0 18rpx 36rpx #234b9c16,
    0 4rpx 8rpx #234b9c0a;
  transform: rotate(-6deg);
  transition:
    transform 400ms ease,
    background 300ms ease;
}
.wifi-symbol {
  position: relative;
  width: 100%;
  height: 100%;
  transform: rotate(6deg);
}
.signal-arc {
  position: absolute;
  left: 50%;
  box-sizing: border-box;
  border: 8rpx solid transparent;
  border-top-color: #2563eb;
  border-radius: 50%;
  transform: translateX(-50%);
}
.signal-arc--outer {
  top: 39rpx;
  width: 88rpx;
  height: 88rpx;
}
.signal-arc--inner {
  top: 64rpx;
  width: 52rpx;
  height: 52rpx;
}
.signal-dot {
  position: absolute;
  top: 91rpx;
  left: 50%;
  width: 13rpx;
  height: 13rpx;
  margin-left: -6.5rpx;
  border-radius: 50%;
  background: #2563eb;
}
.is-connecting .orbit-track {
  animation: orbit 2400ms linear infinite;
}
.is-connecting .orbit-dot {
  background: #2563eb;
}
.is-connecting .wifi-symbol {
  animation: signal 1600ms ease-in-out infinite;
}
.network-wrap {
  position: relative;
  margin-top: 8rpx;
  animation: enter 560ms 60ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
}
.card-depth {
  position: absolute;
  inset: 14rpx 12rpx -14rpx;
  border-radius: 32rpx;
  background: #e8eef9;
  transform: rotate(1deg);
}
.network-card {
  position: relative;
  padding: 8rpx 36rpx;
  border: 2rpx solid #fff;
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 0 16rpx 40rpx #19345a0a;
}
.field {
  padding: 32rpx 0;
}
.field + .field {
  border-top: 1rpx solid #edf0f5;
}
.label {
  display: block;
  margin-bottom: 14rpx;
  color: #6b7890;
  font-size: 24rpx;
  line-height: 1.5;
}
.value {
  display: block;
  color: #172845;
  line-height: 1.45;
  word-break: break-all;
  white-space: pre-wrap;
}
.value--ssid {
  font-size: 40rpx;
  font-weight: 600;
}
.value--password {
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: 32rpx;
}
.button-enter {
  margin-top: 48rpx;
  animation: enter 560ms 120ms ease-out both;
}
.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 104rpx;
  padding: 20rpx 36rpx;
  border-radius: 28rpx;
  background: #2563eb;
  box-shadow: 0 12rpx 24rpx #2563eb24;
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1.6;
  transition:
    transform 150ms ease,
    background 250ms ease,
    box-shadow 250ms ease;
}
.primary-button--pressed {
  transform: scale(0.98);
  background: #1d4ed8;
  box-shadow: 0 4rpx 12rpx #2563eb24;
}
.primary-button[disabled] {
  background: #dce3ed;
  box-shadow: none;
  color: #64748b;
}
.is-connecting .primary-button[disabled] {
  background: #2563eb;
  color: #fff;
}
.primary-button::after {
  border: 0;
}
.button-arrow {
  width: 12rpx;
  height: 12rpx;
  margin-left: 20rpx;
  border-top: 3rpx solid currentColor;
  border-right: 3rpx solid currentColor;
  transform: rotate(45deg);
}
.status-space {
  min-height: 120rpx;
  margin-top: 28rpx;
}
.status {
  text-align: center;
  animation: enter 300ms ease-out both;
}
.status-title,
.status-message {
  display: block;
}
.status-title {
  color: #52637f;
  font-size: 28rpx;
}
.status-message {
  margin-top: 12rpx;
  color: #6b7890;
  font-size: 24rpx;
  line-height: 1.6;
}
.status--danger .status-title {
  color: #b91c1c;
}
.phase-success .signal-tile {
  transform: rotate(0);
  background: #e9f8f0;
}
.phase-success .orbit-track {
  border-color: #c6e8d6;
}
.phase-success .orbit-dot {
  background: #65b78c;
}
.phase-success .primary-button[disabled] {
  background: #16834e;
  color: #fff;
}
.status--success .status-title {
  color: #16834e;
}
.success-check {
  position: absolute;
  top: 42rpx;
  left: 54rpx;
  width: 28rpx;
  height: 48rpx;
  border-right: 8rpx solid #16834e;
  border-bottom: 8rpx solid #16834e;
  transform: rotate(45deg);
  animation: checked 380ms cubic-bezier(0.2, 0.8, 0.3, 1.3) both;
}
.success-ring {
  position: absolute;
  top: 60rpx;
  left: 50%;
  width: 160rpx;
  height: 160rpx;
  margin-left: -80rpx;
  border: 2rpx solid #8dcfac;
  border-radius: 50%;
  opacity: 0;
  animation: ripple 600ms ease-out;
}
.motion-paused .signal-stage,
.motion-paused .orbit-track,
.motion-paused .wifi-symbol,
.motion-paused .network-wrap,
.motion-paused .button-enter,
.motion-paused .status,
.motion-paused .success-check,
.motion-paused .success-ring {
  animation-play-state: paused;
}
@keyframes enter {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
@keyframes orbit {
  to {
    transform: rotate(360deg);
  }
}
@keyframes signal {
  50% {
    opacity: 0.45;
  }
}
@keyframes checked {
  from {
    opacity: 0;
    transform: rotate(45deg) scale(0.5);
  }
  to {
    opacity: 1;
    transform: rotate(45deg) scale(1);
  }
}
@keyframes ripple {
  from {
    opacity: 0.7;
    transform: scale(0.8);
  }
  to {
    opacity: 0;
    transform: scale(1.6);
  }
}
@media (prefers-reduced-motion: reduce) {
  .signal-stage,
  .is-connecting .orbit-track,
  .is-connecting .wifi-symbol,
  .network-wrap,
  .button-enter,
  .status,
  .success-check,
  .success-ring {
    animation: none;
  }
  .signal-tile,
  .primary-button {
    transition: none;
  }
}
