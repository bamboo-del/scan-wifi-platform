{
  "appid": "touristappid",
  "compileType": "miniprogram",
  "miniprogramRoot": "dist/",
  "projectname": "scan-wifi-mini-program",
  "setting": {
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "urlCheck": true,
    "compileWorklet": false,
    "uglifyFileName": false,
    "uploadWithSourceMap": true,
    "packNpmManually": false,
    "packNpmRelationList": [],
    "minifyWXSS": true,
    "minifyWXML": true,
    "localPlugins": false,
    "disableUseStrict": false,
    "useCompilerPlugins": false,
    "condition": false,
    "swc": false,
    "disableSWC": true,
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    }
  },
  "condition": {
    "miniprogram": {
      "list": [
        {
          "name": "连接页（本地示例 scene）",
          "pathName": "pages/connect/index",
          "query": "scene=0123456789abcdef0123456789abcdef",
          "scene": 1047
        },
        {
          "name": "Wi-Fi 诊断（仅开发版/体验版）",
          "pathName": "pages/wifi-diagnostics/index",
          "query": "",
          "scene": 1001
        }
      ]
    }
  },
  "simulatorPluginLibVersion": {},
  "packOptions": {
    "ignore": [],
    "include": []
  },
  "editorSetting": {},
  "libVersion": "3.15.2"
}
