# Runtime
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3100
# 0 disables proxy trust. A positive value enables the explicit address allowlist below.
TRUST_PROXY_HOPS=0
# Comma-separated proxy IPs/CIDRs; never trust arbitrary forwarded headers by hop count alone.
TRUST_PROXY_ADDRESSES=
ADMIN_WEB_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# PostgreSQL (generated by `pnpm setup:env` for local Docker Compose)
POSTGRES_DB=scan_wifi
POSTGRES_OWNER_USER=scan_wifi
POSTGRES_OWNER_PASSWORD=
POSTGRES_APP_USER=scan_wifi_app
POSTGRES_APP_PASSWORD=
DATABASE_URL=
MIGRATION_DATABASE_URL=
DATABASE_POOL_MAX=10

# Generate exactly 32 random bytes and encode as base64.
# PowerShell: $b=New-Object byte[] 32; $rng=[Security.Cryptography.RandomNumberGenerator]::Create(); $rng.GetBytes($b); $rng.Dispose(); [Convert]::ToBase64String($b)
WIFI_ENCRYPTION_KEY_BASE64=

# Generate at least 32 random bytes. Used to sign opaque administrator sessions.
SESSION_SECRET=
SESSION_TTL_HOURS=12

# One-time administrator initialization. Remove the password from the environment after initialization.
INITIAL_ADMIN_USERNAME=wifi_admin
INITIAL_ADMIN_PASSWORD=

# WeChat server-only credentials. Never use VITE_ or any mini-program bundle field for AppSecret.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_QR_PAGE=pages/connect/index
WECHAT_ENV_VERSION=develop

# local-placeholder is allowed only outside production. wechat requires valid credentials.
QR_CODE_PROVIDER=local-placeholder
QR_CODE_STORAGE_DIR=./storage/qrcodes

# Official WeChat documentation currently marks the Wi-Fi API family as delisted.
# Keep false until the target AppID passes iOS and Android physical-device verification.
MINIPROGRAM_ENABLE_LEGACY_WIFI_API=false
MINIPROGRAM_AD_UNIT_ID=
MINIPROGRAM_BRAND_NAME=轻连 WiFi
